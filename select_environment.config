# Environment Selection Configuration
# This file specifies which environment module to load for the agent

# Current active environment
# Valid options: car_environment, game_environment
# Override for Jupyter/CI: export EXPERIENCE_ENGINE_ACTIVE_ENV=game_environment (main.ipynb sets this by default).
ACTIVE_ENVIRONMENT=game_environment

# GUI Visualization
# Set to True to show a real-time visualization window
# Set to False to run without GUI (useful for headless servers)
GUI=True

# Where environment images go: terminal = OpenCV window; jupyter = notebook widget (see main.ipynb)
# DISPLAY_MODE=terminal

# Environment-specific settings can be added below
# [car_environment]
# ip=192.168.4.1
# port=100

# [game_environment]
# gameSize=64

